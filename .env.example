# Postgres connection used by docker-compose and the Makefile targets.
# POSTGRES_HOST/PORT are how the *host* reaches the container; inside the
# compose network the service is reachable as `postgres:5432`.
POSTGRES_HOST=localhost
# Host-side port. 5432/5433 are often already taken by other local databases.
POSTGRES_PORT=5435
POSTGRES_USER=cube
POSTGRES_PASSWORD=cube
POSTGRES_DB=olist
