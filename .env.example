# Postgres connection used by docker-compose and the Makefile targets.
# POSTGRES_HOST/PORT are how the *host* reaches the container; inside the
# compose network the service is reachable as `postgres:5432`.
POSTGRES_HOST=localhost
# Host-side port. 5432/5433 are often already taken by other local databases.
POSTGRES_PORT=5435
POSTGRES_USER=cube
POSTGRES_PASSWORD=cube
POSTGRES_DB=ecom

CUBEJS_DEV_MODE=true
CUBEJS_SCHEMA_PATH=model
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=postgres
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=ecom
CUBEJS_DB_USER=cube
CUBEJS_DB_PASS=cube

# --- Ingestion: which source, which connection -------------------------------
# These identify the Airbyte connection Dagster tracks and the asset-key prefix
# it stamps (orchestration/defs/airbyte/defs.yaml). AIRBYTE_SOURCE_NAME must
# equal the dbt source `name` in your _<source>__sources.yml, or the Dagster
# graph splits in two (see docs/orchestration.md).
#
# Defaults point at the Stripe example so `make example-stripe` runs out of the
# box. Bringing your own source? Set these to your source and connection names.
AIRBYTE_SOURCE_NAME=stripe
AIRBYTE_CONNECTION_NAME=Stripe -> Postgres (raw)

# --- Stripe example source (only used when the Stripe example is installed) ---
STRIPE_ACCOUNT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_START_DATE=

# --- Airbyte -----------------------------------------------------------------
# Populated by `make airbyte-creds`, which reads them out of the abctl install.
# The Makefile forwards these to Terraform as TF_VAR_* values.
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=

# NOTE: the Postgres *destination* does not use POSTGRES_HOST above. The
# connector runs as a pod inside abctl's kind cluster, where "localhost" is the
# pod itself, so it reaches this machine through the kind bridge gateway.
# ingestion/terraform/variables.tf defaults that to 172.21.0.1; override with
# TF_VAR_postgres_host if `docker network inspect kind` shows a different one.